{
  "name": "dicta-server",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "prettier --check . && tsc",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "node --test --test-timeout=5000 \"test/**/*.test.ts\"",
    "test:live": "node --test \"test/live/*.live.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "ws": "^8.22.0"
  }
}
